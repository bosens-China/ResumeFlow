{
  "name": "@resumeflow/server",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "development": "./src/app.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --dir ../.. test apps/server/src/test"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@hono/swagger-ui": "^0.6.2",
    "@modelcontextprotocol/hono": "^2.0.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@resumeflow/shared": "workspace:*",
    "fflate": "^0.8.3",
    "hono": "^4.9.0",
    "hono-openapi": "^1.5.0",
    "pagedjs": "0.4.3",
    "pino": "^10.4.0",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.20.0"
  }
}
